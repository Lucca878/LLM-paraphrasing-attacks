# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# LLM Provider
# "ollama"   — local Ollama instance (default; good for testing with small models)
# "together" — Together AI cloud (recommended for the full 405B / 235B variants)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=together
TOGETHER_API_KEY=your_together_api_key_here

# Optional: override Ollama endpoint (default: http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1
